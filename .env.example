# IBO Platform — environment variable template (Phase 1)
# Copy to .env for local development. NEVER commit real values
# (see docs/phase-1/CREDENTIAL_AND_SECRETS_MODEL.md).

# Backend HTTP port
PORT=

# Backend version override (optional; falls back to package.json version)
IBO_BACKEND_VERSION=

# PostgreSQL connection string — MUST use a limited (non-superuser) DB user.
# Supplied automatically inside docker compose; set manually for local runs.
DATABASE_URL=
